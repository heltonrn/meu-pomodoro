# Copie para `keystore.properties` (raiz do projeto, ignorado pelo git) e preencha
# com os dados da sua chave de upload.
#
# Caminho do .jks relativo à raiz do projeto (use / e não \ — barra invertida é escape aqui).
# Guarde o .jks na pasta credentials/ (ignorada pelo git) e faça backup fora do projeto.
storeFile=credentials/meu-pomodoro-release.jks
storePassword=
keyAlias=
keyPassword=
